{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "align",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/align.py",
            "console": "integratedTerminal",
            "justMyCode": false, 
            "args": [
                "--config" ,
                "configs/align_config.json",
                "--debug",
            ]
        },
        {
            "name": "baseline",
            "type": "debugpy",
            "request": "launch",
            "program": "baseline.py",
            "console": "integratedTerminal",
            "justMyCode": false, 
            "args": [
                "--config" ,
                "rmsd_config.json",
                "--debug",
            ]
        },
        {
            "name": "save pockets",
            "type": "debugpy",
            "request": "launch",
            "program": "save_pockets.py",
            "console": "integratedTerminal",
            "justMyCode": false, 
            "args": [
                "--config" ,
                "configs/save_pockets_config.json",
                "--debug",
            ]
        },
        {
            "name": "regular softBBS",
            "type": "debugpy",
            "request": "launch",
            "program": "aligner_dl/trainers/lightning_trainer.py",
            "console": "integratedTerminal",
            "justMyCode": false, 
            "args": [
                "--config" ,
                "aligner_dl/configs/soft_bb.yaml",
             
            ]
        },
        {
            "name": "virtual softBBS",
            "type": "debugpy",
            "request": "launch",
            "program": "aligner_dl/trainers/lightning_trainer.py",
            "console": "integratedTerminal",
            "justMyCode": false, 
            "args": [
                "--config" ,
                "aligner_dl/configs/virtual_soft_bb.yaml",
             
            ]
        },
        {
            "name": "infer virtual softBBS",
            "type": "debugpy",
            "request": "launch",
            "program": "aligner_dl/scripts/inference.py",
            "console": "integratedTerminal",
            "justMyCode": false, 
            "args": [
                "--config" ,
                "aligner_dl/configs/inference_virtual_soft_bb.yaml",
             
            ]
        },
        {
            "name": "infer tmalign",
            "type": "debugpy",
            "request": "launch",
            "program": "aligner_dl/trainers/lightning_trainer.py",
            "console": "integratedTerminal",
            "justMyCode": false, 
            "args": [
                "--config" ,
                "aligner_dl/configs/tm_align.yaml",
                "--validate_only",
             
            ]
        },
        {
            "name": "Inference Script",
            "type": "debugpy",
            "request": "launch",
            "program": "inference.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--config", 
                "config.yaml",
                "--checkpoint", 
                "path/to/your/model.ckpt",
                "--output_dir", 
                "results",
                "--experiment_name",
                "inference_run"
            ]
        },
        {
            "name": "Split CSV by Ligand",
            "type": "debugpy",
            "request": "launch",
            "program": "aligner_dl/datasets/utils/split_dataset.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--input_csv", 
                // "results/alignment_temp_results/2025-02-01_17-48-34_3000.csv",
                "results/alignment_results/2025-02-04_09-07-32_106886.csv",
                "--output_dir", 
                "datasets/csv_files/protein_grouping_1206",       // Directory to save the train, val, and test CSVs
                "--test_size", 
                "0.0",               // Optional: Adjust the test set size (default 0.2)
                "--val_size", 
                "0.2",
                // "--group_by_ligand"               // Optional: Adjust the validation set size (default 0.25)
            ]
        }
    ]
}