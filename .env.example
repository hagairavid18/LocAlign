# Copy to .env (untracked) in the repo root and edit only what differs from your layout.
# Precedence: variable set in the shell or job > .env > default below. The file is loaded
# automatically by aligner_dl/utils/constants.py; no need to source it. From a git worktree
# the .env of the main checkout is used.
#
# LOCALIGN_DATA_ROOT is read from the real environment only (it locates this file, so it
# cannot be set here). Default: the repo root, or the main checkout when run from a worktree.
# export LOCALIGN_DATA_ROOT=/path/to/LocAlign

# Ligand directory (prepared PDB files). Default: <DATA_ROOT>/../ligands_25_10_2025
# LOCALIGN_LIGAND_DIR=
# ScanNet features. Default: <DATA_ROOT>/../scannet_2212
# LOCALIGN_SCANNET_DIR=
# Legacy ScanNet atom-type features. Default: <DATA_ROOT>/../scannet_atom_types
# LOCALIGN_SCANNET_ATOM_TYPES_DIR=
# SoftAlign sources. Default: <DATA_ROOT>/../SoftAlign
# LOCALIGN_SOFTALIGN_DIR=
# PLASMA sources. Default: <DATA_ROOT>/../PLASMA-Protein-Local-Alignment
# LOCALIGN_PLASMA_DIR=
# DaliLite install. Default: <DATA_ROOT>/../DaliLite.v5
# LOCALIGN_DALI_DIR=

# Comet logging for aligner_dl/trainers/lightning_trainer.py
# COMET_API_KEY=
# COMET_WORKSPACE=
